---
// SPDX-License-Identifier: MIT
// Landing page. Layout follows the system documented in /workspace/xmtp-ref/notes.md (patterns only).
// The docs stay in Starlight (src/content/docs). Numbers come from MEASUREMENTS.md and the Proof page.
import "@fontsource-variable/dm-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/landing.css";
import { Image } from "astro:assets";
import Wordmark from "../components/Wordmark.astro";
import feedShot from "../assets/client-feed.png";
import { REPO, prompts } from "../prompts";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const u = (p: string) => `${base}${p}`;
const blob = (p: string) => `${REPO}/blob/main/${p}`;
const title = "RunFarcaster: Read and post on Farcaster from your own server";
const description = "RunFarcaster sets up a Farcaster node and app of your own, with no gatekeepers in between.";
const canonical = new URL(base, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
const ogAlt = "RunFarcaster: Read and post on Farcaster from your own server. 01 Rent a server, 02 Start the node, 03 Open the app.";

const heroCmd = `# 1. Rent a server
IP=$(./provision.sh)
# 2. Start the node
ssh root@$IP "SNAPCHAIN_AGREE_NO_REWARDS=yes MIN_FREE_GB=900 bash -s" < node.sh
# 3. Open the app
./deploy-client.sh "$IP"`;

const steps = [
  {
    n: "01", label: "Rent", step: "Provision compute", title: "A server you control.",
    text: "provision.sh rents a Hetzner server with a disk big enough for Farcaster's data. You log in with your own SSH key, and the firewall can limit SSH to your address.",
    cmd: `MY_IP=$(curl -4 -s https://ifconfig.me)
IP=$(SSH_KEY=my-key \\
  SERVER_TYPE="" \\
  VOLUME_GB=1000 \\
  WATCHDOG=0 \\
  SSH_SOURCE_CIDRS="$MY_IP/32" \\
  ./provision.sh)`,
  },
  {
    n: "02", label: "Start", step: "Set up a read node", title: "A node you read from.",
    text: "node.sh starts a Snapchain read node. It downloads every message, then keeps up on its own without an API key. One measured run on a cax31 took about 14 hours.",
    cmd: `ssh root@$IP \\
  "SNAPCHAIN_AGREE_NO_REWARDS=yes MIN_FREE_GB=900 bash -s" \\
  < node.sh`,
  },
  {
    n: "03", label: "Open", step: "Create a client", title: "A client you post from.",
    text: "deploy-client.sh serves a web app from the same server. It shows your feed from your node and posts, likes and follows through it.",
    cmd: `./deploy-client.sh "$IP"`,
  },
];

const fixes = [
  ["The server type is sold out", "Step 1", "the-server-type-is-sold-out"],
  ["SSH stops working", "Step 1", "ssh-stops-working"],
  ["The disk fills while the snapshot loads", "Step 2", "the-disk-fills-while-the-snapshot-loads"],
  ["Node.js is too old", "Step 3", "nodejs-is-too-old"],
];

const scripts = [
  ["provision.sh", "Rents the server"],
  ["node.sh", "Starts the node"],
  ["deploy-client.sh", "Puts the app online"],
  ["teardown.sh", "Deletes everything"],
  ["watchdog.sh", "Optional: deletes the server after a set time"],
  ["client/src/signer.ts", "Adds the app's key"],
];

const master = prompts.master;
const goalRaw = /Goal: (.*)/.exec(master)?.[1] ?? "";
const goal = goalRaw.charAt(0).toUpperCase() + goalRaw.slice(1);
// Lucide "sparkle" (ISC), see THIRD_PARTY_NOTICES.md.
const sparkle = '<svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z" /></svg>';
const arrow = `<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`;
const right = `<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="M1.5 6h9M6.5 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u("favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RunFarcaster" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="sitemap" href={u("sitemap-index.xml")} />
  </head>
  <body class="lp">
    <a class="skip" href="#main">Skip to content</a>
    <header class="lp-header">
      <div class="wrap lp-header-row">
        <Wordmark href={base} />
        <nav class="lp-nav" aria-label="Main">
          <a href={u("quickstart/")}>Quickstart</a>
          <a href={u("how-farcaster-works/")}>How Farcaster works</a>
          <a href={u("server-and-node/")}>Server</a>
          <a href={u("proof/")}>Proof</a>
          <a href={u("fix/")}>Fix a problem</a>
          <a href={REPO}>GitHub<Fragment set:html={arrow} /></a>
          <a class="btn btn-sm" href={u("quickstart/")}>Run the 3 commands</a>
        </nav>
        <details class="lp-menu">
          <summary>Menu</summary>
          <nav aria-label="Main, small screens">
            <a href={u("quickstart/")}>Quickstart</a>
            <a href={u("how-farcaster-works/")}>How Farcaster works</a>
            <a href={u("server-and-node/")}>Server</a>
            <a href={u("proof/")}>Proof</a>
            <a href={u("fix/")}>Fix a problem</a>
            <a href={REPO}>GitHub</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <section class="wrap hero" aria-labelledby="hero-title">
        <p class="eyebrow">Open source · No API keys · MIT</p>
        <h1 id="hero-title">Read and post on Farcaster from your own server<span class="dot">.</span></h1>
        <p class="hero-sub">RunFarcaster sets up a Farcaster node and app of your own, with no gatekeepers in between.</p>
        <div class="hero-ctas">
          <a class="hbtn hbtn-primary" href={u("ai-assistant/")}><Fragment set:html={sparkle} />Set up with AI</a>
          <a class="hbtn hbtn-secondary" href={u("quickstart/")}>Run the 3 commands</a>
        </div>
        <div class="terminal hero-term" role="group" aria-label="The 3 steps">
          <div class="term-head">
            <span class="eyebrow">The 3 steps</span>
            <button type="button" class="copy" data-copy="hero-cmd">Copy</button>
          </div>
          <pre id="hero-cmd" tabindex="0" aria-label="The 3 step commands"><code>{heroCmd}</code></pre>
          <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
        </div>
        <p class="hero-term-note">You need a Hetzner token and an SSH key first. <a href={u("quickstart/")}>The Quickstart</a> has the full setup.</p>
        <p class="hero-note">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14"><circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M4.3 7.2 6.2 9l3.5-4" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
          <span>We ran a node on Farcaster mainnet and <a href={u("proof/#posted-to-mainnet")}>posted from it on 18 Oct 2026</a>.</span>
        </p>
        {/* AUTHOR: your intro line, one or two sentences in your own words: who you are and why you wanted your own node. */}
      </section>

      <section class="wrap trio" aria-label="Overview">
        {steps.map((s, i) => (
          <div>
            <p class="eyebrow">{s.n} / {s.step}</p>
            <h2 class="h-sm"><a class="card-link" href={u(`quickstart/#step-${i + 1}`)}>{s.title}</a></h2>
            <p>{s.text}</p>
          </div>
        ))}
      </section>

      <section class="wrap split cmds" aria-labelledby="cmd-title">
        <div>
          <p class="eyebrow">The 3 steps</p>
          <h2 id="cmd-title" class="h-md">Copy each step into your terminal.</h2>
          <p>You need a Hetzner account, a terminal and Node.js. <a href={u("server-and-node/")}>Server and node</a> shows how to set them up.</p>
          <a class="textlink" href={u("how-farcaster-works/")}>What each step does<Fragment set:html={right} /></a>
        </div>
        <div class="terminal" role="group" aria-label="The 3 steps">
          {steps.map((s, i) => (
            <div class="term-step">
              <div class="term-head">
                <span class="eyebrow">{s.n} / {s.label}</span>
                <button type="button" class="copy" data-copy={`cmd-${i}`}>Copy</button>
              </div>
              <pre id={`cmd-${i}`} tabindex="0" aria-label={`Step ${i + 1} command`}><code>{s.cmd}</code></pre>
            </div>
          ))}
          <p class="term-foot">When you&rsquo;re done, delete everything: <code>CONFIRM=snapchain-read-node ./teardown.sh</code></p>
          <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
        </div>
      </section>


      <section class="wrap split noline" aria-labelledby="how-title">
        <div>
          <p class="eyebrow">How it works</p>
          <h2 id="how-title" class="h-md">You run your own copy of Farcaster.</h2>
          <p>Farcaster&rsquo;s messages live on a network called Snapchain. Your node keeps a full copy and stays in sync. Your app reads only from your node.</p>
          <a class="textlink" href={u("how-farcaster-works/")}>How Farcaster works<Fragment set:html={right} /></a>
        </div>
        <ol class="rows">
          <li>
            <h3>The network</h3>
            <p>Validators add new messages to the network in blocks.</p>
          </li>
          <li>
            <h3>Your node</h3>
            <p>Your node stores every message and passes your posts on to the network.</p>
          </li>
          <li>
            <h3>Your app</h3>
            <p>Your app shows your feed and lets you post, using only your node.</p>
          </li>
        </ol>
      </section>

      <section class="wrap panel split" aria-labelledby="acct-title">
        <div>
          <p class="eyebrow">Keys</p>
          <h2 id="acct-title" class="h-md">How your account stays safe.</h2>
          <a class="textlink" href={u("first-cast/")}>Post with an app key<Fragment set:html={right} /></a>
        </div>
        <div>
          <h3 class="h-sm">Your recovery phrase stays on your computer.</h3>
          <p>You use it once in your browser to give the app its own key. The app does not save it or send it anywhere.</p>
          <h3 class="h-sm">The app&rsquo;s key can post, like and follow.</h3>
          <p>It can&rsquo;t move money, edit your profile or approve other keys.</p>
          <h3 class="h-sm">Adding the key costs no gas.</h3>
          <p>Your browser signs one message for your node. You make no crypto transaction.</p>
          <h3 class="h-sm">Tested on mainnet.</h3>
          <p>We added a key and posted a cast on 18 Oct 2026. Likes, recasts and follows have only run against a mock node.</p>
        </div>
      </section>

      <section class="wrap split" aria-labelledby="ai-title">
        <div>
          <p class="eyebrow">With your AI assistant</p>
          <h2 id="ai-title" class="h-md">Or let your AI assistant do it.</h2>
          <p>Copy one prompt into Claude Code, Codex or Cursor. It does one step at a time and asks before each one.</p>
          <p>Or install the RunFarcaster skill:</p>
          <pre class="skill-cmd" tabindex="0" aria-label="Skill install command"><code>npx skills add sudharshanx/runfarcaster --skill runfarcaster</code></pre>
          <a class="textlink" href={u("ai-assistant/")}>All prompts and the skill<Fragment set:html={right} /></a>
        </div>
        <div class="card">
          <p class="eyebrow">Prompt for a coding assistant</p>
          <p class="mono">{goal}</p>
          <button type="button" class="btn" data-copy="master-prompt">Copy the prompt<Fragment set:html={arrow} /></button>
          <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
          <details class="more">
            <summary>Show the whole prompt</summary>
            <pre id="master-prompt" tabindex="0" aria-label="Full prompt">{master}</pre>
          </details>
          <p class="fine">Never paste your recovery phrase or a token into an AI assistant.</p>
        </div>
      </section>

      <section class="wrap split" aria-labelledby="proof-title">
        <div>
          <p class="eyebrow">Proof of work</p>
          <h2 id="proof-title" class="h-md">We ran it ourselves.</h2>
          <div class="proof-cast">
            <p class="eyebrow">Mainnet</p>
            <h3 class="h-sm">Posted to mainnet from our own node.</h3>
            <dl class="pc-times">
              <div><dt>Key added</dt><dd>20:53:29 IST</dd></div>
              <div><dt>Cast confirmed</dt><dd>20:53:47 IST</dd></div>
            </dl>
            <blockquote class="pc-text">My first cast on a local node</blockquote>
            <p class="pc-note">18 Oct 2026, from our own account. The phrase was typed into the app on localhost and never left the browser.</p>
            <a class="textlink" href="https://farcaster.xyz/nashrad/0x4b4eb31b">See the cast<Fragment set:html={right} /></a>
          </div>
          <p>We synced our own node on 18 Oct 2026. It took 14 hours. When it finished, it held 914M messages.</p>
          <p>The proof page has our logs, screenshots and every number we measured.</p>
          <a class="textlink" href={u("proof/")}>See the proof<Fragment set:html={right} /></a>
          {/* AUTHOR: one line on what it felt like when the feed first loaded from your own node. */}
        </div>
        <figure class="shot">
          <Image src={feedShot} alt="The app on a desktop screen: Connected to your node, the Add app key prompt, then the Following feed for @dwr with casts from Greg and Darryl Yeo" widths={[640, 1040, 1560]} sizes="(max-width: 900px) 100vw, 520px" loading="eager" />
          <figcaption>The app reading the Following feed of @dwr (FID 3) from our synced node on 18 Oct 2026.</figcaption>
        </figure>
        {/* AUTHOR: 59 s vertical video (9:16): rent the server, a synced /v1/info, the feed on a phone. Put it here with a caption that says how you made it. */}
      </section>

      <section class="wrap split" aria-labelledby="fix-title">
        <div>
          <p class="eyebrow">Fix a problem</p>
          <h2 id="fix-title" class="h-md">If something breaks, start here.</h2>
          <p>Common problems with the 3 steps, each with the exact message and the fix.</p>
          <a class="textlink" href={u("fix/")}>Fix a problem<Fragment set:html={right} /></a>
        </div>
        <ul class="linkgrid plain">
          {fixes.map(([t, d, a]) => (
            <li><a href={u(`fix/#${a}`)}><span class="lg-t">{t}</span><span class="lg-d">{d}</span></a></li>
          ))}
        </ul>
      </section>

      <section class="wrap split last" aria-labelledby="src-title">
        <div>
          <p class="eyebrow">Open source · MIT</p>
          <h2 id="src-title" class="h-md">Read the code first.</h2>
          <p>Every script is plain bash or TypeScript with comments. Read it before you run it.</p>
          <p>Developers can build their own apps, bots and analytics on their node, and lift the app&rsquo;s node code into them.</p>
          <a class="textlink" href={u("build-on-your-node/")}>Build on your node<Fragment set:html={right} /></a>
        </div>
        <ul class="linkgrid">
          {scripts.map(([f, d]) => (
            <li><a href={blob(f)}><span class="lg-t">{f}<Fragment set:html={arrow} /></span><span class="lg-d">{d}</span></a></li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="wrap lp-footer">
      <div class="f-brand">
        <Wordmark href={base} />
        <p>MIT licensed. Source on GitHub.</p>
      </div>
      <nav aria-label="Docs">
        <h2>Docs</h2>
        <a href={u("quickstart/")}>Quickstart</a>
        <a href={u("how-farcaster-works/")}>How Farcaster works</a>
        <a href={u("server-and-node/")}>Server and node</a>
        <a href={u("first-cast/")}>Post with an app key</a>
        <a href={u("build-on-your-node/")}>Build on your node</a>
        <a href={u("fix/")}>Fix a problem</a>
        <a href={u("reference/")}>Scripts and settings</a>
      </nav>
      <nav aria-label="Project">
        <h2>Project</h2>
        <a href={u("proof/")}>Proof</a>
        <a href={u("docs-issues/")}>Docs issues we found</a>
        <a href={u("how-ai-was-used/")}>How AI was used</a>
        <a href={u("llms.txt")}>llms.txt</a>
      </nav>
      <nav aria-label="License and source">
        <h2>Source</h2>
        <a href={blob("LICENSE")}>MIT license</a>
        <a href={REPO}>GitHub</a>
        <a href={blob("SECURITY.md")}>Security</a>
      </nav>
      <p class="f-fine">中文: a person will write the Chinese version. We will not publish a machine translation.</p>
    </footer>

    <script>
      const status = (el: Element, msg: string) => {
        const s = el.closest(".terminal, .card")?.querySelector("[data-copy-status]");
        if (s) s.textContent = msg;
      };
      for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        btn.addEventListener("click", async () => {
          const text = document.getElementById(btn.dataset.copy ?? "")?.textContent ?? "";
          const label = btn.querySelector("svg") ? null : btn.textContent;
          try {
            await navigator.clipboard.writeText(text);
            status(btn, "Copied to clipboard");
            btn.dataset.state = "copied";
            if (label) btn.textContent = "Copied";
          } catch {
            status(btn, "Copy failed. Select the text and copy it by hand.");
          }
          setTimeout(() => { delete btn.dataset.state; if (label) btn.textContent = label; }, 2000);
        });
      }
    </script>
  </body>
</html>
