---
// SPDX-License-Identifier: MIT
// Landing page. Layout follows the system documented in /workspace/xmtp-ref/notes.md (patterns only).
// The docs stay in Starlight (src/content/docs). Numbers come from MEASUREMENTS.md and the Proof page.
import "@fontsource-variable/dm-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/landing.css";
import { Image } from "astro:assets";
import Wordmark from "../components/Wordmark.astro";
import PartsDiagram from "../components/landing/PartsDiagram.astro";
import feedShot from "../assets/client-feed.png";
import { REPO, prompts } from "../prompts";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const u = (p: string) => `${base}${p}`;
const blob = (p: string) => `${REPO}/blob/main/${p}`;
const title = "RunFarcaster: Read and post on Farcaster from your own server";
const description = "RunFarcaster sets up a Farcaster node and app of your own, with no gatekeepers in between.";
const canonical = new URL(base, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
const ogAlt = "RunFarcaster: Read and post on Farcaster from your own server. 01 Rent a server, 02 Start the node, 03 Open the app.";

const steps = [
  {
    n: "01", title: "Rent a server", cmd: "./provision.sh",
    text: "Checks the price, then rents a Hetzner server with a 1000 GB disk.",
    example: "Picked cax31, about $0.164 an hour with the volume. The server is up at <your-ip>.",
  },
  {
    n: "02", title: "Start the node", cmd: "node.sh",
    text: "Starts a Snapchain read node and waits until it holds every message.",
    example: "Node is in sync after 14 h 06 m: 914,243,963 messages, every shard less than 10 s behind.",
  },
  {
    n: "03", title: "Open the app", cmd: "./deploy-client.sh",
    text: "Puts the web app online on the same server, over HTTPS.",
    example: "App is up at https://<ip-with-dashes>.sslip.io. The status says Connected to your node.",
  },
];

const master = prompts.master;
// Lucide "sparkle" (ISC), see THIRD_PARTY_NOTICES.md.
const sparkle = '<svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z" /></svg>';
const arrow = `<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`;
const right = `<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="M1.5 6h9M6.5 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u("favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RunFarcaster" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="sitemap" href={u("sitemap-index.xml")} />
  </head>
  <body class="lp">
    <a class="skip" href="#main">Skip to content</a>
    <header class="lp-header">
      <div class="wrap lp-header-row">
        <Wordmark href={base} />
        <nav class="lp-nav" aria-label="Main">
          <a href={u("quickstart/")}>Full run</a>
          <a href={u("how-farcaster-works/")}>How Farcaster works</a>
          <a href={u("server-and-node/")}>Server</a>
          <a href={u("proof/")}>Proof</a>
          <a href={REPO}>GitHub<Fragment set:html={arrow} /></a>
          <a class="hbtn hbtn-primary hbtn-sm" href="#setup">Set up with AI</a>
        </nav>
        <details class="lp-menu">
          <summary>Menu</summary>
          <nav aria-label="Main, small screens">
            <a href="#setup">Set up with AI</a>
            <a href={u("quickstart/")}>Full run</a>
            <a href={u("how-farcaster-works/")}>How Farcaster works</a>
            <a href={u("server-and-node/")}>Server</a>
            <a href={u("proof/")}>Proof</a>
            <a href={REPO}>GitHub</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <section class="wrap hero" aria-labelledby="hero-title">
        <p class="eyebrow">Open source · MIT · No API keys</p>
        <h1 id="hero-title">Read and post on Farcaster from your own server<span class="dot">.</span></h1>
        <p class="hero-sub">RunFarcaster sets up a Farcaster node and app of your own, with no gatekeepers in between.</p>
        <div class="hero-ctas">
          <a class="hbtn hbtn-primary" href="#setup"><Fragment set:html={sparkle} />Set up with AI</a>
          <a class="hbtn hbtn-secondary" href={u("instant-run/")}>Instant run in 5 minutes</a>
        </div>
        <p class="hero-instant"><span>Instant run uses a node that is already synced, until Oct 24, 2026.</span></p>
        <p class="hero-note">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14"><circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M4.3 7.2 6.2 9l3.5-4" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
          <span>A node set up by these scripts synced on mainnet and <a href="#proof">posted a cast on 18 Oct 2026</a>.</span>
        </p>
        {/* AUTHOR: your intro line, one or two sentences in your own words: who you are and why you wanted your own node. */}
      </section>

      <section id="setup" class="wrap setup" aria-labelledby="setup-title">
        <div class="setup-head">
          <p class="eyebrow">Set up with AI</p>
          <h2 id="setup-title" class="h-md">3 commands. Your assistant runs them with you.</h2>
          <p>Paste this prompt into Claude Code, Codex or Cursor. The assistant installs the RunFarcaster skill, then runs each step after you say yes.</p>
        </div>
        <div class="setup-grid">
          <div class="terminal prompt-box" role="group" aria-label="Set up with AI prompt">
            <div class="term-head">
              <span class="eyebrow">Prompt</span>
              <button type="button" class="copy copy-dark" data-copy="master-prompt">Copy prompt</button>
            </div>
            <pre id="master-prompt" tabindex="0" aria-label="Prompt text">{master}</pre>
            <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
          </div>
          <ol class="steps">
            {steps.map((s) => (
              <li>
                <p class="eyebrow">{s.n}</p>
                <h3 class="h-sm">{s.title}</h3>
                <p>{s.text} <code>{s.cmd}</code></p>
                <div class="report">
                  <p class="report-tag">Example report</p>
                  <p>{s.example}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <p class="setup-foot">Keep your recovery phrase and your Hetzner token out of the chat. Exact commands, to run by hand: <a href={u("quickstart/")}>Full run</a>. More prompts: <a href={u("ai-assistant/")}>Set up with AI</a>.</p>
      </section>

      <section class="wrap trio" aria-label="What you get">
        <div>
          <h2 class="h-sm">Read from your own copy.</h2>
          <p>Your node keeps every Farcaster message. Your app reads your feed from it, with no API key.</p>
        </div>
        <div>
          <h2 class="h-sm">Post with your own key.</h2>
          <p>The app adds a gasless app key, then sends your casts, likes and follows through your node.</p>
        </div>
        <div>
          <h2 class="h-sm">Build on it.</h2>
          <p>Bots, apps and analytics jobs call the same HTTP API as the app. <a href={u("build-on-your-node/")}>Build on your node</a></p>
        </div>
      </section>

      <section class="wrap parts" aria-labelledby="how-title">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title" class="h-md">How the parts connect.</h2>
        <PartsDiagram />
        <a class="textlink" href={u("how-farcaster-works/")}>How Farcaster works<Fragment set:html={right} /></a>
      </section>

      <section id="proof" class="wrap split" aria-labelledby="proof-title">
        <div>
          <p class="eyebrow">Proof of work</p>
          <h2 id="proof-title" class="h-md">We ran it ourselves.</h2>
          <article class="cast" aria-label="Our first mainnet cast">
            <header class="cast-head">
              <span class="cast-avatar" aria-hidden="true"></span>
              <span class="cast-who"><strong>Our test account</strong><span>via the RunFarcaster app on localhost</span></span>
            </header>
            <p class="cast-text">My first cast on a local node</p>
            <p class="cast-time"><time datetime="2026-10-18T20:53:47+05:30">20:53:47 IST · 18 Oct 2026</time> · Farcaster mainnet</p>
            <p class="cast-hash"><code>0x4b4eb31bb28cf0d6d0583c7fc022a60f0af50ec2</code></p>
            <ol class="cast-trail">
              <li><span>20:53:29</span>Gasless <code>KEY_ADD</code> accepted</li>
              <li><span>20:53:47</span>Cast confirmed by the node, 18 s later</li>
            </ol>
            <a class="textlink" href="https://farcaster.xyz/nashrad/0x4b4eb31b">See the cast<Fragment set:html={right} /></a>
          </article>
          <p>I typed the recovery phrase into the app on localhost. It never left the browser: only the signed key and the cast went to our node.</p>
          <p>We synced the node in 14 h 06 m. It then held 914,243,963 messages.</p>
          <a class="textlink" href={u("proof/")}>Logs, screenshots and every number<Fragment set:html={right} /></a>
          {/* AUTHOR: one line on what it felt like when the feed first loaded from your own node. */}
        </div>
        <figure class="shot">
          <Image src={feedShot} alt="The app on a desktop screen: Connected to your node, the Add app key prompt, then the Following feed for @dwr with casts from Greg and Darryl Yeo" widths={[640, 1040, 1560]} sizes="(max-width: 900px) 100vw, 520px" loading="lazy" />
          <figcaption>The app reading the Following feed of @dwr (FID 3) from our synced node on 18 Oct 2026.</figcaption>
        </figure>
        {/* AUTHOR: 59 s vertical video (9:16): rent the server, a synced /v1/info, the feed on a phone. Put it here with a caption that says how you made it. */}
      </section>

      <section class="wrap panel limits" aria-labelledby="limits-title">
        <p class="eyebrow">Limits</p>
        <h2 id="limits-title" class="h-md">What it costs, and what it does not do.</h2>
        <dl class="limits-grid">
          <div><dt>Cost</dt><dd>About $0.164 an hour on a Hetzner cax31 with a 1000 GB volume, $2.31 until synced. The server bills until <code>teardown.sh</code> deletes it. cax31 was sold out on 18 Oct 2026; the script then picks cpx42, about $0.255 an hour and untested.</dd></div>
          <div><dt>Time</dt><dd>About 14 hours from renting the server to synced, measured once on cax31. Other server types: not measured.</dd></div>
          <div><dt>Writes</dt><dd>A read node makes no blocks. It checks your cast and passes it to the validators. HTTP 200 means sent on, not in a block, so the app checks that the cast landed.</dd></div>
          <div><dt>Your recovery phrase</dt><dd>Adding the app key needs it once, typed into the app on your own computer. Use a test account. Never paste it into an AI assistant.</dd></div>
          <div><dt>Tested</dt><dd>Adding a key and one cast ran on mainnet. Likes, recasts and follows ran against a mock node only.</dd></div>
          <div><dt>Rewards</dt><dd>A read node earns none. Step 2 sets <code>SNAPCHAIN_AGREE_NO_REWARDS=yes</code> to say you accept that.</dd></div>
        </dl>
      </section>

      <section class="wrap closing" aria-labelledby="close-title">
        <h2 id="close-title" class="h-md">Run your own Farcaster node.</h2>
        <div class="hero-ctas">
          <a class="hbtn hbtn-primary" href="#setup"><Fragment set:html={sparkle} />Set up with AI</a>
          <a class="hbtn hbtn-secondary" href={u("quickstart/")}>Run the commands yourself</a>
        </div>
      </section>
    </main>

    <footer class="wrap lp-footer">
      <div class="f-brand">
        <Wordmark href={base} />
        <p>MIT licensed. <a href={REPO}>Source on GitHub</a>.</p>
      </div>
      <nav aria-label="Docs">
        <h2>Docs</h2>
        <a href={u("ai-assistant/")}>Set up with AI</a>
        <a href={u("quickstart/")}>Full run</a>
        <a href={u("instant-run/")}>Instant run</a>
        <a href={u("how-farcaster-works/")}>How Farcaster works</a>
        <a href={u("server-and-node/")}>Server and node</a>
        <a href={u("first-cast/")}>Post with an app key</a>
        <a href={u("build-on-your-node/")}>Build on your node</a>
        <a href={u("fix/")}>Fix a problem</a>
        <a href={u("reference/")}>Scripts and settings</a>
        <a href={u("glossary/")}>Glossary</a>
      </nav>
      <nav aria-label="Project">
        <h2>Project</h2>
        <a href={u("proof/")}>Proof</a>
        <a href={u("docs-issues/")}>Docs issues</a>
        <a href={u("how-ai-was-used/")}>How AI was used</a>
        <a href={u("llms.txt")}>llms.txt</a>
      </nav>
      <nav aria-label="License and source">
        <h2>Source</h2>
        <a href={REPO}>Source on GitHub</a>
        <a href={blob("LICENSE")}>MIT license</a>
        <a href={blob("SECURITY.md")}>Security</a>
      </nav>
      <p class="f-fine">中文: a person will write the Chinese version. There will be no machine translation.</p>
    </footer>

    <script>
      for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        btn.addEventListener("click", async () => {
          const text = document.getElementById(btn.dataset.copy ?? "")?.textContent ?? "";
          const label = btn.textContent;
          const status = btn.closest(".terminal")?.querySelector("[data-copy-status]");
          try {
            await navigator.clipboard.writeText(text);
            if (status) status.textContent = "Copied to clipboard";
            btn.textContent = "Copied";
          } catch {
            if (status) status.textContent = "Copy failed. Select the text and copy it by hand.";
            btn.textContent = "Copy failed";
          }
          setTimeout(() => { btn.textContent = label; }, 2000);
        });
      }
    </script>
  </body>
</html>
