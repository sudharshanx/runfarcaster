---
// SPDX-License-Identifier: MIT
// "How the parts connect": browser, app and read node (one server), validators. Two lanes: reading and posting.
// Facts: how-farcaster-works.mdx, "Where a post goes from a read node". Lays out in a row when there is
// room, and stacks top to bottom below 640px of its own width (container query), on the landing page and in the docs.
interface Props { caption?: boolean }
const { caption = true } = Astro.props;
const links = [
  { read: ["→", "loads the app"], post: ["→", "you write a cast"] },
  { read: ["→", "asks for the feed"], post: ["→", "cast signed with your app key"] },
  { read: ["←", "copies every new block"], post: ["→", "checks it, passes it on"] },
];
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
const arrow = (kind: string, [dir, label]: string[]) =>
  `<p class="pd-a pd-${kind}" data-dir="${dir}"><span class="pd-line"></span><span class="pd-lbl">${esc(label)}</span></p>`;
const cell = (i: number) => `<div class="pd-link">${arrow("read", links[i].read)}${arrow("post", links[i].post)}</div>`;
---
<figure class="pd not-content">
  <p class="pd-legend" aria-hidden="true"><span class="pd-key pd-key-read">Reading</span><span class="pd-key pd-key-post">Posting</span></p>
  <div class="pd-flow">
    <div class="pd-box"><strong>Your browser</strong><span>on your laptop or phone</span></div>
    <Fragment set:html={cell(0)} />
    <div class="pd-server">
      <span class="pd-tag">Your server</span>
      <div class="pd-box"><strong>Your app</strong><span>served over HTTPS by Caddy</span></div>
      <Fragment set:html={cell(1)} />
      <div class="pd-box"><strong>Your read node</strong><span>a full copy of every message</span></div>
    </div>
    <Fragment set:html={cell(2)} />
    <div class="pd-box pd-net"><strong>Validators</strong><span>the Farcaster network; they make the blocks</span></div>
  </div>
  <figcaption class={caption ? "pd-cap" : "sr-only"}>A validator puts the cast in a block. Your node copies that block like any other, and the cast shows up in your feed.</figcaption>
</figure>

<style is:global>
  .pd {
    --pd-ink: #15191f; --pd-text: #5a6069; --pd-line: #dfe2e7; --pd-bg: #fff; --pd-box: #f8f9fc;
    --pd-read: #15191f; --pd-post: #244af0;
    container-type: inline-size; margin: 0; font-family: inherit; color: var(--pd-text);
  }
  [data-theme="dark"] .pd {
    --pd-ink: #eef0f3; --pd-text: #b4bac4; --pd-line: #353b45; --pd-bg: #15191f; --pd-box: #1d222a;
    --pd-read: #eef0f3; --pd-post: #8ea4ff;
  }
  .pd-legend { display: flex; gap: 20px; margin: 0 0 14px; font-size: 13px; line-height: 1.4; color: var(--pd-text); }
  .pd-key { display: inline-flex; align-items: center; gap: 8px; }
  .pd-key::before { content: ""; width: 26px; height: 0; border-top: 2px solid var(--pd-read); }
  .pd-key-post::before { border-top: 2px dashed var(--pd-post); }
  .pd-flow { display: flex; align-items: stretch; gap: 0; }
  .pd-server { position: relative; display: flex; align-items: stretch; flex: 2.4 1 0; padding: 26px 10px 10px; border: 1.5px dashed #b9bfc8; border-radius: 10px; }
  [data-theme="dark"] .pd-server { border-color: #4a515c; }
  .pd-tag { position: absolute; top: 6px; left: 12px; font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: 0.6px; text-transform: uppercase; color: var(--pd-text); line-height: 1.2; }
  .pd-box { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 4px; padding: 14px 12px; border: 1px solid var(--pd-line); border-radius: 8px; background: var(--pd-box); text-align: center; }
  .pd-box strong { color: var(--pd-ink); font-size: 15px; font-weight: 600; line-height: 1.25; }
  .pd-box span { font-size: 12.5px; line-height: 1.35; }
  .pd-net { border-color: var(--pd-ink); }
  .pd-link { flex: 1 1 0; min-width: 92px; display: flex; flex-direction: column; justify-content: center; gap: 12px; padding: 0 6px; }
  .pd-a { position: relative; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 12px; line-height: 1.3; text-align: center; }
  .pd-line { position: relative; display: block; width: 100%; height: 0; border-top: 2px solid var(--pd-read); }
  .pd-post .pd-line { border-top: 2px dashed var(--pd-post); }
  .pd-post .pd-lbl { color: var(--pd-post); }
  .pd-read .pd-lbl { color: var(--pd-ink); }
  .pd-line::after { content: ""; position: absolute; top: -6px; width: 0; height: 0; border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
  .pd-a[data-dir="→"] .pd-line::after { right: -1px; border-left: 8px solid var(--pd-read); }
  .pd-a[data-dir="←"] .pd-line::after { left: -1px; border-right: 8px solid var(--pd-read); }
  .pd-post[data-dir="→"] .pd-line::after { border-left-color: var(--pd-post); }
  .pd-cap { margin: 14px 0 0; font-size: 14px; line-height: 1.55; color: var(--pd-text); }
  .pd .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Narrow: stack top to bottom; arrows turn vertical, labels sit beside them. */
  @container (max-width: 640px) {
    .pd-flow, .pd-server { flex-direction: column; }
    .pd-server { padding: 30px 12px 12px; }
    .pd-box { padding: 12px; }
    .pd-link { flex-direction: row; justify-content: center; gap: 18px; padding: 6px 0; min-width: 0; min-height: 76px; }
    .pd-a { flex-direction: row; align-items: stretch; gap: 8px; flex: 1 1 0; max-width: 170px; text-align: left; }
    .pd-a .pd-lbl { align-self: center; }
    .pd-line { width: 0; height: auto; min-height: 56px; border-top: 0; border-left: 2px solid var(--pd-read); flex: none; }
    .pd-post .pd-line { border-top: 0; border-left: 2px dashed var(--pd-post); }
    .pd-line::after { top: auto; left: -6px !important; right: auto !important; border-left: 5px solid transparent !important; border-right: 5px solid transparent !important; border-top: 0; border-bottom: 0; }
    .pd-a[data-dir="→"] .pd-line::after { bottom: -1px; border-top: 8px solid var(--pd-read); }
    .pd-a[data-dir="←"] .pd-line::after { top: -1px; border-bottom: 8px solid var(--pd-read); }
    .pd-post[data-dir="→"] .pd-line::after { border-top-color: var(--pd-post); }
  }
</style>
