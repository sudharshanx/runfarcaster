---
// Starlight override for SocialIcons: the landing page's nav links, so docs and home share one header.
import { REPO } from "../config.mjs";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const path = Astro.url.pathname;
const links = [
  ["Quickstart", `${base}quickstart/`],
  ["How Farcaster works", `${base}how-farcaster-works/`],
  ["Hetzner", `${base}hetzner/`],
  ["Proof", `${base}proof/`],
  ["Fix a problem", `${base}fix/`],
];
---
<nav class="hl" aria-label="Site">
  {links.map(([t, h]) => <a href={h} aria-current={path === h ? "page" : undefined}>{t}</a>)}
  <a href={REPO}>GitHub<svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10"><path d="M2 8 8 2M3.5 2H8v4.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></a>
</nav>
<style>
  .hl { display: flex; align-items: center; gap: 22px; }
  .hl a { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; font-size: 14px; font-weight: 550; color: #15191f; text-decoration: none; white-space: nowrap; }
  .hl a:hover { color: #244af0; }
  .hl a[aria-current="page"] { color: #244af0; }
  .hl a:focus-visible { outline: 2px solid #244af0; outline-offset: 2px; border-radius: 3px; }
  @media (max-width: 72rem) { .hl { gap: 14px; } }
</style>
